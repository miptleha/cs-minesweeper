<Window x:Class="MinesweeperWpf.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый рекорд!"
        Width="300"
        SizeToContent="Height" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F0F0"
        Icon="{x:Null}">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заменили Label на TextBlock, у Label странные отступы по умолчанию -->
        <TextBlock Grid.Row="0" Text="Введите ваше имя:" Margin="0,0,0,5" />
        
        <!-- Убрали жесткий Width, чтобы поле растягивалось по размеру окна -->
        <TextBox x:Name="NameBox" Grid.Row="1" Height="24" Margin="0,5,0,20" Text="Игрок" VerticalContentAlignment="Center" />

        <!-- Кнопки выровнены вправо -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="28" Margin="0,0,10,0" IsDefault="True" Click="OnOkClick" />
            <Button Content="Отмена" Width="80" Height="28" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
