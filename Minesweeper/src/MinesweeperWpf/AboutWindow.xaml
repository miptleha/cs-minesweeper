<Window x:Class="MinesweeperWpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F0F0"
        Icon="{x:Null}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Иконка мины -->
        <Image Grid.Row="0" Grid.Column="0" Width="64" Height="64"
               Source="/Resources/bomb.png" VerticalAlignment="Top" Margin="0,0,15,0" />

        <!-- Текст справа от иконки -->
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
            <!-- FontSize="20" визуально равен Font 16F в WinForms -->
            <TextBlock Text="Сапёр" FontSize="20" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBlock Text="Классическая игра «Сапёр»." Margin="0,0,0,3" />
            <TextBlock Text="Автор: miptleha." />
        </StackPanel>

        <!-- Ссылка на GitHub -->
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,0,0" TextWrapping="Wrap">
            <Hyperlink NavigateUri="https://github.com/miptleha/cs-minesweeper"
                       RequestNavigate="OnHyperlinkRequestNavigate">
                Скачать последнюю версию с GitHub
            </Hyperlink>
        </TextBlock>

        <!-- Кнопка OK (внизу справа) -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="OK" Width="80" Height="30"
                HorizontalAlignment="Right" Margin="0,20,0,0"
                IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
