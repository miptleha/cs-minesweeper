<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MinesweeperAvalonia.Windows.NamePromptWindow"
        Title="Новый рекорд!"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="{x:Null}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Введите ваше имя:"/>
        <TextBox x:Name="NameBox" Text="Игрок"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="OkButton" Content="OK" Width="70" Click="OnOkClick" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="70" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
