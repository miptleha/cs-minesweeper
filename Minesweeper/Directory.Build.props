<Project>
  <!--
    Этот файл является единым источником истины для версии.
    Все проекты в решении будут использовать эти значения.
  -->
  <PropertyGroup>
    <!-- Основная версия пакета/продукта. Следуйте SemVer: MAJOR.MINOR.PATCH -->
    <Version>0.3.1</Version>

    <!--
      AssemblyVersion — это "бинарная" идентичность сборки, которая используется средой выполнения для связывания.
      Для стабильности её часто фиксируют на уровне MAJOR.0.0.0 и меняют только при MAJOR-обновлениях.
    -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>

    <!-- FileVersion — версия, которая отображается в свойствах файла в Windows. -->
    <FileVersion>0.3.1.0</FileVersion>

    <!-- InformationalVersion — подробная версия, которую видно в свойствах сборки и которая может включать суффиксы. -->
    <InformationalVersion>0.3.1</InformationalVersion>
  </PropertyGroup>
</Project>